;; StarCdr_v17 (C# final) — caps→esc, LShift→symbols hold, space-hold→shift
(defcfg
process-unmapped-keys yes
concurrent-tap-hold yes
)
(defsrc
grv 1 2 3 4 5 6 7 8 9 0 - =
q w e r t y u i o p [ ] \
caps a s d f g h j k l ; '
lsft z x c v b n m , . /
spc
)
;; v w h m x  z _ o u ⌫
;; s r n t g  y c a e i .
;; q k f l d  b p j [ ]
(deflayer starcdr
@tld 1 2 3 4 5 6 7 8 9 0 , =
v w h m x z S-- o u bspc @scol S-' -
esc s r n t g y c a e i .
@sym q k f l d b p j [ ]
@sps
)
;; Full QWERTY layer (games, guests, muscle-memory fallback)
(deflayer qwerty
@tldq 1 2 3 4 5 6 7 8 9 0 - =
q w e r t y u i o p [ ] \
esc a s d f g h j k l @scol '
@sym z x c v b n m , . /
@sps
)
;; Symbol Layer — now activated by HOLDING left shift
(deflayer symbols
1 2 3 4 5 6 7 8 9 0 @dplus @deql `
@dlow @dand S-; S-2 ' S-7 S-\ \ S-/ S-3 S-5 S-6 XX
S-` S-6 S-1 S-9 S-0 S-, S-. S-- S-[ S-] @dpip /
XX XX 1 2 S-= S-4 - S-8 8 9 0
@sps
)
(defalias
sps  (tap-hold-press 150 150 spc lsft)
sym  (tap-hold 150 150 lsft (layer-while-held symbols))
scol (tap-hold 200 200 ; S-;)
tld  (tap-hold 200 200 grv (layer-switch qwerty))
tldq (tap-hold 200 200 grv (layer-switch starcdr))
dplus (macro S-= S-=)
deql  (macro = =)
dand  (macro S-7 S-7)
dlow  (macro S-- S--)
dpip  (macro S-\ S-\)
)
